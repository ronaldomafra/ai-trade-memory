# Credentials are optional for offline tests; never include real values in this file.
OPENROUTER_API_KEY=
MARKETAUX_API_TOKEN=
# Optional proxy for Polymarket only, configured locally (never logged).
POLYMARKET_PROXY_URL=
# Operational configuration, not an exchange credential.
POC_DATA_DIR=./data
# Optional Linux-host control container: absolute host path to the same data directory.
POC_HOST_DATA_DIR=
# Host group allowed to access /var/run/docker.sock.
DOCKER_GID=
# Only needed when enabling the TLS proxy profile; use your own DNS name.
POC_PUBLIC_HOST=
POC_CONTROL_PORT=8080

